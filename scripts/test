# Run the stol test suite in a container.
#
# Usage: scripts/test [subtest ...]   (default: all subtests)

set -euo pipefail

REPO_ROOT="$(dirname "$(dirname "$(realpath "$0")")")"

IMAGE=stol-test
docker build -q -t "$IMAGE" -f "$REPO_ROOT/scripts/Dockerfile" "$REPO_ROOT" >/dev/null

docker run --rm --privileged \
  -v "$REPO_ROOT:/pkg:ro" \
  "$IMAGE" \
  bash /pkg/scripts/container-test "$@"
