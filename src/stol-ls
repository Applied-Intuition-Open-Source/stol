set -euo pipefail

NAME=""
RECURSIVE=0
FLAT=0
REVERSE=0
SORT_TIME=0

show-help() {
  echo >&2 "stol ls [-R [-l]] [-r] [-t] [<project>]"
  echo >&2 ""
  echo >&2 "List all projects, or list worktrees within a project."
  echo >&2 ""
  echo >&2 "  -R   list worktrees across every project, grouped by project"
  echo >&2 "  -l   with -R, show a flat project/worktree list instead"
  echo >&2 "  -r   list in reverse order"
  echo >&2 "  -t   sort by modification time, newest first"
}

while [[ ${#} -gt 0 ]]
do
  opt="${1}"
  shift

  case "${opt}" in
    -h | --help)
      show-help
      exit 0
      ;;
    -[Rlrt]*)
      # combined short flags, e.g. -Rl
      for (( i=1; i<${#opt}; i++ ))
      do
        case "${opt:i:1}" in
          R) RECURSIVE=1 ;;
          l) FLAT=1 ;;
          r) REVERSE=1 ;;
          t) SORT_TIME=1 ;;
          *)
            echo >&2 "Unknown flag: -${opt:i:1}"
            show-help
            exit 1
            ;;
        esac
      done
      ;;
    *)
      if [[ -n "$NAME" ]]
      then
        echo >&2 "Unexpected argument: ${opt}"
        show-help
        exit 1
      fi
      NAME="${opt}"
      ;;
  esac
done

PROJECTS_DIR="$STOL_ROOT/projects"

order-dirs() {
  local -n _arr="$1"
  local i dir

  if [[ "$SORT_TIME" -eq 1 ]]
  then
    local sorted=()
    while IFS= read -r dir
    do
      sorted+=( "$dir" )
    done < <(
      for dir in "${_arr[@]}"
      do
        [[ -d "$dir" ]] || continue
        printf '%s\t%s\n' "$(stat -c %Y "$dir")" "$dir"
      done | sort -rn | cut -f2-
    )
    _arr=( "${sorted[@]}" )
  fi

  if [[ "$REVERSE" -eq 1 ]]
  then
    local reversed=()
    for (( i=${#_arr[@]}-1; i>=0; i-- ))
    do
      reversed+=( "${_arr[i]}" )
    done
    _arr=( "${reversed[@]}" )
  fi
}

mtime-prefix() {
  [[ "$SORT_TIME" -eq 1 ]] || return 0
  echo "$(date -d "@$(stat -c %Y "$1")" '+%Y-%m-%d %H:%M')  "
}

print-worktree() {
  local dir="$1" prefix="$2"
  echo "$(mtime-prefix "$dir")${prefix}$(basename "$dir")  ($(git -C "$dir" branch --show-current 2>/dev/null))"
}

list-worktrees() {
  local project_dir="$1" prefix="$2" dir entry
  local dirs=( "$project_dir"/*/ )
  order-dirs dirs
  # list worktrees (directories that aren't .repo)
  for dir in "${dirs[@]}"
  do
    [[ -d "$dir" ]] || continue
    entry="$(basename "$dir")"
    [[ "$entry" == ".repo" ]] && continue
    print-worktree "$dir" "$prefix"
  done
}

PROJECT_DIRS=( "$PROJECTS_DIR"/*/ )
order-dirs PROJECT_DIRS

if [[ "$FLAT" -eq 1 && "$RECURSIVE" -eq 0 ]]
then
  echo >&2 "-l requires -R"
  show-help
  exit 1
fi

if [[ "$RECURSIVE" -eq 1 ]]
then
  if [[ -n "$NAME" ]]
  then
    echo >&2 "-R cannot be combined with a project name"
    show-help
    exit 1
  fi

  if [[ "$FLAT" -eq 1 ]]
  then
    # collect worktrees across all projects (in glob order, since order-dirs
    # is applied globally below) so ordering applies across the whole list
    ALL_WORKTREES=()
    for dir in "$PROJECTS_DIR"/*/
    do
      [[ -d "$dir" ]] || continue
      for wt in "$dir"*/
      do
        [[ -d "$wt" ]] || continue
        [[ "$(basename "$wt")" == ".repo" ]] && continue
        ALL_WORKTREES+=( "$wt" )
      done
    done
    order-dirs ALL_WORKTREES
    for wt in "${ALL_WORKTREES[@]}"
    do
      print-worktree "$wt" "$(basename "$(dirname "$wt")")/"
    done
  else
    FIRST=1
    for dir in "${PROJECT_DIRS[@]}"
    do
      [[ -d "$dir" ]] || continue
      [[ "$FIRST" -eq 1 ]] || echo
      FIRST=0
      echo "$(basename "$dir"):"
      echo
      list-worktrees "$dir" "  "
    done
  fi
elif [[ -z "$NAME" ]]
then
  # list all projects
  for dir in "${PROJECT_DIRS[@]}"
  do
    [[ -d "$dir" ]] || continue
    echo "$(mtime-prefix "$dir")$(basename "$dir")"
  done
else
  PROJECT_DIR="$PROJECTS_DIR/$NAME"

  if [[ ! -d "$PROJECT_DIR" ]]
  then
    echo >&2 "No such project: $NAME"
    exit 1
  fi

  list-worktrees "$PROJECT_DIR" ""
fi
