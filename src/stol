set -euo pipefail

# user-specifiable config with defaults
STOL_ROOT="${STOL_ROOT:-/mnt/work}"
# when STOL_PREFIX is unset, branches are created without a prefix
STOL_PREFIX="${STOL_PREFIX:-}"
export STOL_ROOT STOL_PREFIX

show-help() {
  echo >&2 "usage: stol <command> [<args>]"
  echo >&2 ""
  echo >&2 "Available commands:"
  compgen -c stol- | sed 's/^stol-/   /' | sort -u >&2
}

assert-reflink-supported() {
  workdir=$(mktemp -d --tmpdir="$STOL_ROOT")
  trap 'rm -rf "$workdir"' EXIT
  echo "reflink probe" > "$workdir/src.txt"
  if ! cp --reflink=always "$workdir/src.txt" "$workdir/dst.txt" 2>/dev/null
  then
    echo >&2 "reflink is not supported on this filesystem."
    echo >&2 "This means $STOL_ROOT is not compatible with this tool"
    exit 1
  fi
  rm -rf "$workdir"
  trap - EXIT
}

subcommand=""

while [[ ${#} -gt 0 ]]
do
  opt="${1}"
  shift

  case "${opt}" in
    -h | --help)
      show-help
      exit 0
      ;;
    *)
      subcommand="${opt}"
      break
      ;;
  esac
done

if [[ -z "$subcommand" ]]; then
  show-help
  exit 1
fi

executable="stol-${subcommand}"

if ! command -v "$executable" &>/dev/null; then
  echo >&2 "stol: '$subcommand' is not a stol command. See 'stol --help'."
  exit 1
fi

# a relative path or trailing slash breaks subcommands in confusing ways
if [[ "$STOL_ROOT" != /* || "$STOL_ROOT" == */ ]]
then
  echo >&2 "invalid STOL_ROOT '$STOL_ROOT': must be an absolute path with no trailing slash"
  exit 1
fi

case "$subcommand" in
  format-drive | create-image)
    # these commands set up the filesystem, so reflink won't be available yet
    ;;
  *)
    assert-reflink-supported
    mkdir -p "$STOL_ROOT/projects"
    ;;
esac
exec "$executable" "$@"
