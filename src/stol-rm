set -euo pipefail

# WTSPEC is the path provided by the user, which can take multiple path-like forms.
# Usage described in show-help
WTSPEC=""
GIT_FLAGS=()

show-help() {
  echo >&2 "stol rm <worktree> [flags]"
  echo >&2 "  stol rm .                    remove the current worktree"
  echo >&2 "  stol rm <name>               remove worktree in the current project"
  echo >&2 "  stol rm <project>/<name>     remove worktree in a specific project"
  echo >&2 "additional flags are forwarded to git worktree remove, as in:"
  echo >&2 "  stol rm . --force"
}

while [[ ${#} -gt 0 ]]
do
  opt="${1}"
  shift

  case "${opt}" in
    -h | --help)
      show-help
      exit 0
      ;;
    -*)
      GIT_FLAGS+=("${opt}")
      ;;
    *)
      if [[ -n "$WTSPEC" ]]
      then
        echo >&2 "Unexpected argument: ${opt}"
        show-help
        exit 1
      fi
      WTSPEC="${opt}"
      ;;
  esac
done

main() {
  if [[ -z "$WTSPEC" ]]
  then
    echo >&2 "Must provide a name"
    show-help
    exit 1
  fi

  if [[ "$WTSPEC" == "." ]]
  then
    # WTSPEC: .

    # Must be inside a worktree, not just the project directory
    if [[ "$(dirname "$(dirname "$PWD")")" != "$STOL_ROOT/projects" ]]
    then
      echo >&2 "'stol rm .' must be run from inside a worktree"
      exit 1
    fi
    PROJECT_DIR="$(dirname "$PWD")"
    WTNAME="$(basename "$PWD")"
  elif [[ "$WTSPEC" == */* ]]
  then
    # WTSPECT: project/worktree
    PROJECT_NAME="${WTSPEC%%/*}"
    WTNAME="${WTSPEC#*/}"
    PROJECT_DIR="$STOL_ROOT/projects/$PROJECT_NAME"

    if [[ ! -d "$PROJECT_DIR" ]]
    then
      echo >&2 "project not found: $PROJECT_DIR"
      exit 1
    fi
  else
    # WTSPEC: worktree
    if [[ "$(dirname "$PWD")" == "$STOL_ROOT/projects" ]]
    then
      PROJECT_DIR="$PWD"
      WTNAME="$WTSPEC"
    elif [[ "$(dirname "$(dirname "$PWD")")" == "$STOL_ROOT/projects" ]]
    then
      PROJECT_DIR="$(dirname "$PWD")"
      WTNAME="$WTSPEC"
    else
      echo >&2 "cd into a project directory or worktree before running this command"
      exit 1
    fi
  fi

  WTPATH="$PROJECT_DIR/$WTNAME"

  if [[ ! -d "$WTPATH" ]]
  then
    echo >&2 "worktree $WTPATH does not exist"
    exit 1
  fi

  # Run hooks while the worktree still exists so they can access its contents.

  # Repo-tracked hook: shipped by the repo itself at .stol/hooks/pre-remove.
  # Runs first, since it's the repo's own baseline automation.
  REPO_HOOK="$WTPATH/.stol/hooks/pre-remove"
  if [[ -x "$REPO_HOOK" ]]
  then
    (cd "$WTPATH" && "$REPO_HOOK")
  fi

  # Project-level hook: host-specific, not tracked by git. Runs second, so
  # it can assume the repo-tracked hook already ran.
  PROJECT_HOOK="$PROJECT_DIR/.stol/hooks/pre-remove"
  if [[ -x "$PROJECT_HOOK" ]]
  then
    (cd "$WTPATH" && "$PROJECT_HOOK")
  fi

  if [[ "$WTPATH" == "$PWD" ]]
  then
    echo >&2 "warning: removing your current directory; cd elsewhere after this command"
  fi

  set -x

  git -C "$WTPATH" worktree remove "${GIT_FLAGS[@]}" .

  set +x
  echo "removed: $WTPATH"
}

main >&2
